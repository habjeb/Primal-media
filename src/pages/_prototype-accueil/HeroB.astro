---
// PROTOTYPE accueil — Variante B « Bandeau de marque » : un bandeau compact, puis directement la une.
import LogoMark from '../../components/LogoMark.astro';
import { withBase } from '../../lib/paths';
---

<section class="band">
  <div class="band-mark" aria-hidden="true"><LogoMark height={420} /></div>
  <div class="band-id">
    <LogoMark class="band-logo" height={96} />
    <div>
      <p class="band-brand">PRIMAL <span>MÉDIA</span></p>
      <h1 class="band-tagline">L’actu fight amateur · MMA, grappling, kick &amp; boxe</h1>
    </div>
  </div>
  <nav class="band-links" aria-label="Raccourcis">
    <a class="pill" href={withBase('/calendrier/')}>Calendrier</a>
    <a class="pill" href={withBase('/actualites/resultats/')}>Résultats</a>
    <a class="pill" href={withBase('/athletes/')}>Combattants</a>
  </nav>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 1.2rem;
    align-items: center;
    margin: 1rem 0 1.2rem;
    padding: 1.6rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: radial-gradient(60% 120% at 85% 50%, #26262a 0%, #121214 70%);
  }
  .band-mark { position: absolute; right: -60px; top: 50%; transform: translateY(-50%); opacity: 0.08; filter: grayscale(1); pointer-events: none; }
  .band-id { position: relative; display: flex; align-items: center; gap: 1.1rem; }
  .band-id :global(.band-logo) { height: 96px; width: auto; filter: drop-shadow(0 4px 14px rgb(0 0 0 / 0.6)); }
  .band-brand {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-style: italic;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 0.9;
    background: var(--metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .band-brand span { opacity: 0.75; }
  .band-tagline { margin: 0.4rem 0 0; color: var(--gold); font-family: var(--sans); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; }
  .band-links { position: relative; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pill {
    display: inline-flex;
    padding: 0.65rem 1.3rem;
    border-radius: 999px;
    background: var(--pill);
    border: 1px solid rgb(255 255 255 / 0.32);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .pill:hover { border-color: rgb(255 255 255 / 0.7); color: white; }
  @media (min-width: 900px) {
    .band { grid-template-columns: minmax(0, 1fr) auto; }
  }
</style>
