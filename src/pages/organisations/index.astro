---
import ExampleNote from '../../components/ExampleNote.astro';
import { athletesForOrg, eventsForOrg, getSite, itemsForOrg } from '../../lib/content';
import Base from '../../layouts/BaseLayout.astro';

const site = await getSite();
const kindLabel = { professionnelle: 'Professionnelle', amateur: 'Amateur', mixte: 'Pro et amateur' };
---

<Base
  title="Organisations"
  description="Les organisations suivies par Primal Média : ligues pro modestes, galas et circuits amateurs."
>
  <header class="page-intro">
    <h1>Organisations</h1>
    <p class="lede">Les ligues, galas et clubs suivis par Primal Média, avec leurs combattants, leurs cartes et leurs publications.</p>
  </header>
  <ExampleNote kind="list" />
  <ul class="org-grid">
    {
      site.organisations.map(({ org }) => (
        <li>
          <a class="org-card" href={org.href}>
            <p class="kicker">{kindLabel[org.kind]} · {org.place}</p>
            <h2>{org.name}</h2>
            <p>{org.description}</p>
            <p class="meta-line">
              {itemsForOrg(org.id, site.items).length} articles · {athletesForOrg(org.id, site.athletes).length} athlètes · {eventsForOrg(org.id, site.events).length} cartes
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
