---
// PROTOTYPE — couleur signature de Primal Média. Code jetable, rendu seulement en développement.
// Barre flottante : A Rouge sang, B Turquoise, C Citron, ou l'identité actuelle (noir et argent).
// Le choix est mémorisé pendant la navigation, pour parcourir tout le site dans une couleur.
const variants = [
  { key: 'A', label: 'Rouge sang', color: '#ef5a4f' },
  { key: 'B', label: 'Turquoise', color: '#3cc8b4' },
  { key: 'C', label: 'Citron', color: '#c8e64b' },
  { key: 'actuelle', label: 'Actuelle : noir et argent', color: '#c3c3c9' },
];
---

<div class="cproto-bar" data-cproto data-variants={JSON.stringify(variants)} role="toolbar" aria-label="Couleur signature (prototype)">
  <span class="cproto-tag">Prototype</span>
  <button type="button" data-cproto-prev aria-label="Couleur précédente">←</button>
  <span class="cproto-swatch" data-cproto-swatch></span>
  <span class="cproto-label" data-cproto-label aria-live="polite"></span>
  <button type="button" data-cproto-next aria-label="Couleur suivante">→</button>
</div>

<style is:global>
  html[data-cproto='A'] { --brand: #ef5a4f; --brand-rgb: 239 90 79; }
  html[data-cproto='B'] { --brand: #3cc8b4; --brand-rgb: 60 200 180; }
  html[data-cproto='C'] { --brand: #c8e64b; --brand-rgb: 200 230 75; }

  /* Où la couleur signature apparaît (toujours les mêmes endroits, avec parcimonie). */
  html[data-cproto]:not([data-cproto='actuelle']) {
    --gold: var(--brand);               /* surtitres, « Prochain rendez-vous », bordures d'encarts */
    --gold-rgb: var(--brand-rgb);
  }
  html[data-cproto]:not([data-cproto='actuelle']) body {
    background:
      radial-gradient(1100px 480px at 100% -10%, rgb(var(--brand-rgb) / 0.09), transparent 55%),
      var(--bg);
  }
  html[data-cproto]:not([data-cproto='actuelle']) .logo-text span {
    background: none;
    color: var(--brand);
  }
  html[data-cproto]:not([data-cproto='actuelle']) .nav-links a[aria-current='page']::after,
  html[data-cproto]:not([data-cproto='actuelle']) .feed-block h2::before,
  html[data-cproto]:not([data-cproto='actuelle']) .section-title::before,
  html[data-cproto]:not([data-cproto='actuelle']) .footer-title {
    background: var(--brand);
  }
  html[data-cproto]:not([data-cproto='actuelle']) .footer-title { background: none; border-left-color: var(--brand); }
  html[data-cproto]:not([data-cproto='actuelle']) .chip[aria-current='page'],
  html[data-cproto]:not([data-cproto='actuelle']) .chip[aria-pressed='true'] {
    background: var(--brand);
    color: #111113;
  }
  html[data-cproto]:not([data-cproto='actuelle']) .rubric-head { border-bottom-color: var(--brand); }
  html[data-cproto]:not([data-cproto='actuelle']) .rubric-head h1 .outline { -webkit-text-stroke-color: var(--brand); }
  html[data-cproto]:not([data-cproto='actuelle']) .visual .slash-a { fill: var(--brand); opacity: 0.55; }
  html[data-cproto]:not([data-cproto='actuelle']) .prose a { text-decoration-color: var(--brand); }
  html[data-cproto]:not([data-cproto='actuelle']) .btn-light:hover,
  html[data-cproto]:not([data-cproto='actuelle']) .band-pill:hover { border-color: var(--brand); }
  html[data-cproto]:not([data-cproto='actuelle']) ::selection { background: var(--brand); color: #111113; }
  html[data-cproto]:not([data-cproto='actuelle']) .band-brand span {
    background: none;
    -webkit-text-fill-color: var(--brand);
    opacity: 1;
  }
  html[data-cproto]:not([data-cproto='actuelle']) .story-ring {
    background: conic-gradient(from 200deg, var(--brand), #6b6b70, var(--brand), #6b6b70, var(--brand));
  }

  .cproto-bar {
    position: fixed; z-index: 100; left: 50%; bottom: 4.5rem; transform: translateX(-50%);
    display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.5rem 0.4rem 0.8rem;
    border-radius: 999px; background: #f4f1ea; color: #111; box-shadow: 0 8px 30px rgb(0 0 0 / 0.5);
    font: 600 0.92rem/1 system-ui, sans-serif; white-space: nowrap;
  }
  .cproto-tag { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #8a2a22; }
  .cproto-bar button { width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 0; background: #111; color: #fff; font-size: 1.1rem; cursor: pointer; }
  .cproto-swatch { width: 1rem; height: 1rem; border-radius: 50%; border: 1px solid #0003; }
  .cproto-label { min-width: 12rem; text-align: center; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-cproto]');
  if (bar) {
    const variants: { key: string; label: string; color: string }[] = JSON.parse(bar.dataset.variants ?? '[]');
    const keys = variants.map((v) => v.key);
    const label = bar.querySelector<HTMLElement>('[data-cproto-label]')!;
    const swatch = bar.querySelector<HTMLElement>('[data-cproto-swatch]')!;
    const STORE = 'primal-media:proto-couleur';
    const read = () => {
      try {
        return new URLSearchParams(location.search).get('couleur') ?? localStorage.getItem(STORE) ?? 'A';
      } catch {
        return 'A';
      }
    };
    const apply = (key: string) => {
      const current = keys.includes(key) ? key : keys[0]!;
      document.documentElement.dataset.cproto = current;
      const v = variants.find((x) => x.key === current)!;
      label.textContent = `${v.key} · ${v.label}`;
      swatch.style.background = v.color;
      try {
        localStorage.setItem(STORE, current);
      } catch {
        /* ignore */
      }
      return current;
    };
    let current = apply(read());
    const step = (delta: number) => {
      current = apply(keys[(keys.indexOf(current) + delta + keys.length) % keys.length]!);
    };
    bar.querySelector('[data-cproto-prev]')?.addEventListener('click', () => step(-1));
    bar.querySelector('[data-cproto-next]')?.addEventListener('click', () => step(1));
    document.addEventListener('keydown', (event) => {
      if ((event.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });
  }
</script>
