---
import { withBase } from '../lib/paths';

const groups = [
  {
    title: 'Rubriques',
    links: [
      { href: '/calendrier/', label: 'Calendrier' },
      { href: '/mma/', label: 'MMA' },
      { href: '/grappling/', label: 'Grappling' },
      { href: '/kick-boxe/', label: 'Kick/Boxe' },
      { href: '/videos/', label: 'Vidéos' },
    ],
  },
  {
    title: 'Le fil',
    links: [
      { href: '/actualites/', label: 'Toutes les actualités' },
      { href: '/actualites/resultats/', label: 'Tous les résultats' },
      { href: '/actualites/horaires/', label: 'Quelle heure, quelle chaîne ?' },
      { href: '/portraits/', label: 'Portraits' },
      { href: '/guides/', label: 'Guides' },
    ],
  },
  {
    title: 'Primal Média',
    links: [
      { href: '/athletes/', label: 'Combattants' },
      { href: '/organisations/', label: 'Organisations' },
      { href: '/a-propos/', label: 'À propos' },
      { href: '/contact/', label: 'Contact' },
      { href: '/credits-photos/', label: 'Crédits photos' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="logo-text">PRIMAL <span>MÉDIA</span></p>
      <p>
        L’actu fight des circuits amateurs et des petites organisations francophones : MMA, grappling,
        kick et boxe, côté combattants. Les entrées marquées « Contenu d’exemple » sont fictives.
      </p>
    </div>
    <div class="footer-cols">
      {
        groups.map((group) => (
          <div>
            <p class="footer-title">{group.title}</p>
            <ul class="footer-links">
              {group.links.map((link) => (
                <li>
                  <a href={withBase(link.href)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
