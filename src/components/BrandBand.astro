---
import { withBase } from '../lib/paths';
import LogoMark from './LogoMark.astro';

/** Bandeau de marque en tête de l'accueil : gorille, nom en métal, accroche et raccourcis. */
const links = [
  { href: '/calendrier/', label: 'Calendrier' },
  { href: '/actualites/resultats/', label: 'Résultats' },
  { href: '/athletes/', label: 'Combattants' },
];
---

<header class="band">
  <div class="band-mark" aria-hidden="true"><LogoMark height={420} /></div>
  <div class="band-id">
    <LogoMark class="band-logo" height={96} />
    <h1>
      <span class="band-brand">PRIMAL <span>MÉDIA</span></span>
      <span class="band-tagline">L’actu fight amateur · MMA, grappling, kick &amp; boxe</span>
    </h1>
  </div>
  <nav class="band-links" aria-label="Raccourcis">
    {
      links.map((link) => (
        <a class="band-pill" href={withBase(link.href)}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .band {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 1.2rem;
    align-items: center;
    margin: 1rem 0 1.2rem;
    padding: 1.6rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: radial-gradient(60% 120% at 85% 50%, #26262a 0%, #121214 70%);
  }
  .band-mark {
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.08;
    filter: grayscale(1);
    pointer-events: none;
  }
  .band-id { position: relative; display: flex; align-items: center; gap: 1.1rem; min-width: 0; }
  .band-id :global(.band-logo) { flex: none; width: auto; height: 96px; filter: drop-shadow(0 4px 14px rgb(0 0 0 / 0.6)); }
  h1 { display: grid; gap: 0.4rem; margin: 0; min-width: 0; }
  .band-brand {
    font-family: var(--display);
    font-weight: 800;
    font-style: italic;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 0.9;
    background: var(--metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .band-brand span { -webkit-text-fill-color: var(--brand); }
  .band-tagline {
    color: var(--brand);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .band-links { position: relative; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .band-pill {
    display: inline-flex;
    padding: 0.65rem 1.3rem;
    border: 1px solid rgb(255 255 255 / 0.32);
    border-radius: 999px;
    background: var(--pill);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .band-pill:hover { border-color: var(--brand); color: white; }
  @media (max-width: 520px) {
    .band { padding: 1.2rem 1rem; }
    .band-id :global(.band-logo) { height: 72px; }
  }
  @media (min-width: 900px) {
    .band { grid-template-columns: minmax(0, 1fr) auto; }
  }
</style>
