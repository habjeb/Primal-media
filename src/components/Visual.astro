---
import { palette } from '../lib/text';

interface Props {
  seed: string;
  initials: string;
  uid?: string;
  label?: string;
  hideInitials?: boolean;
}

const { seed, initials, uid = seed, label = 'Visuel d’exemple', hideInitials = false } = Astro.props;
const colors = palette(seed);
const gid = `g${uid.replace(/[^a-zA-Z0-9]/g, '')}`;
---

<div class="visual">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={colors.bg}></stop>
        <stop offset="100%" stop-color={colors.mid}></stop>
      </linearGradient>
    </defs>
    <rect width="1600" height="900" fill={`url(#${gid})`}></rect>
    <g fill="none" stroke={colors.ink} stroke-width="10" opacity="0.45">
      <polygon points="1180,80 1420,220 1420,500 1180,640 940,500 940,220"></polygon>
      <polygon points="1180,170 1340,270 1340,470 1180,570 1020,470 1020,270"></polygon>
    </g>
    <path d="M0 760 L520 520 L1600 820 L1600 900 L0 900 Z" fill={colors.bg} opacity="0.35"></path>
    {
      !hideInitials && (
        <text
          x="72"
          y="790"
          fill={colors.ink}
          font-size="250"
          font-family="Barlow Condensed, Impact, sans-serif"
          font-weight="800"
        >
          {initials}
        </text>
      )
    }
  </svg>
</div>
