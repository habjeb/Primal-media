---
import { getSite } from '../lib/content';
import { isCurrent, withBase } from '../lib/paths';

const pathname = Astro.url.pathname;
const site = await getSite();

// Point rouge sur « Calendrier » quand un événement a lieu dans les 7 prochains jours.
// Calculé au build : sans reconstruction régulière du site, ce point reste figé à la date du dernier déploiement.
const week = 7 * 24 * 3600 * 1000;
const now = Date.now();
const soon = site.events.some(({ event }) => {
  const delta = event.date.getTime() - now;
  return delta >= -6 * 3600 * 1000 && delta <= week;
});

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/calendrier/', label: 'Calendrier', also: ['/evenements/'], dot: soon },
  { href: '/mma/', label: 'MMA' },
  { href: '/grappling/', label: 'Grappling' },
  { href: '/kick-boxe/', label: 'Kick/Boxe' },
  { href: '/portraits/', label: 'Portraits' },
  { href: '/athletes/', label: 'Combattants' },
  { href: '/guides/', label: 'Guides' },
  { href: '/videos/', label: 'Vidéos' },
];
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href={withBase('/')}>
      <svg class="logo-mark" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" rx="8" fill="#a94b43"></rect>
        <path d="M7 29 L16 7 H20 L11 29 Z" fill="#fff"></path>
        <path d="M16 29 L24 9 H28 L20 29 Z" fill="#d8b46e"></path>
      </svg>
      <span class="logo-text">PRIMAL <span>MÉDIA</span></span>
    </a>
    <div class="header-tools">
      <a class="rss" href={withBase('/rss.xml')}>RSS</a>
    </div>
  </div>
  <div class="wrap">
    <nav aria-label="Principal">
      <ul class="nav-links">
        {
          links.map((link) => {
            const current = isCurrent(pathname, link.href) || (link.also ?? []).some((href) => isCurrent(pathname, href));
            return (
              <li>
                <a href={withBase(link.href)} aria-current={current ? 'page' : undefined}>
                  {link.label}
                  {link.dot && (
                    <span class="live-dot">
                      <span class="sr-only"> (un événement cette semaine)</span>
                    </span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
