---
import { getSite } from '../lib/content';

/**
 * Le site ne publie plus de contenus d’exemple. Ce bandeau reste prêt au cas où un contenu
 * `example: true` serait de nouveau ajouté :
 * - `entry` : sur un contenu fictif (article, fiche, carte marqués `example: true`).
 * - `list`  : en tête des listes, seulement s’il existe au moins un contenu d’exemple sur le site.
 * - `org`   : sur une organisation réelle à laquelle des contenus d’exemple sont rattachés.
 */
interface Props {
  kind?: 'entry' | 'list' | 'org';
}

const { kind = 'entry' } = Astro.props;
const site = kind === 'list' ? await getSite() : undefined;
const hasExamples =
  !site ||
  site.items.some((item) => item.example) ||
  site.events.some(({ event }) => event.example) ||
  site.athletes.some(({ profile }) => profile.example) ||
  site.organisations.some(({ org }) => org.example);
---

{
  !hasExamples ? null : kind === 'org' ? (
    <p class="disclaimer" role="note">
      Organisation réelle. Les combattants, cartes et articles liés marqués « Contenu d’exemple » sont fictifs ; les
      autres sont réels et sourcés.
    </p>
  ) : kind === 'list' ? (
    <p class="disclaimer" role="note">
      Le site mélange contenus réels et contenus d’exemple. Ceux marqués « Contenu d’exemple » sont fictifs :
      personnes, citations, résultats, horaires et chaînes.
    </p>
  ) : (
    <p class="disclaimer" role="note">
      Contenu d’exemple — personnes, citations, résultats, horaires et chaînes sont fictifs.
    </p>
  )
}
