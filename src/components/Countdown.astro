---
import { calendarDaysUntil, formatDay, formatFull } from '../lib/dates';

/**
 * Compte à rebours jusqu’à un événement. Le HTML affiche les valeurs calculées au build ;
 * le script les met à jour chaque seconde dans le navigateur.
 */
interface Props {
  date: Date;
  /** Heure inconnue : seul le nombre de jours est affiché, pas d’heures ni de minutes inventées. */
  daysOnly?: boolean;
}

const { date, daysOnly = false } = Astro.props;
const left = Math.max(0, date.getTime() - Date.now());
const units = [
  // Heure inconnue : jours de calendrier à l’heure de Paris (du 17 au 27 = 10), pas des tranches de 24 h.
  { key: 'days', label: 'jours', value: daysOnly ? Math.max(0, calendarDaysUntil(date)) : Math.floor(left / 86400000) },
  { key: 'hours', label: 'heures', value: Math.floor(left / 3600000) % 24 },
  { key: 'minutes', label: 'min', value: Math.floor(left / 60000) % 60 },
  { key: 'seconds', label: 'sec', value: Math.floor(left / 1000) % 60 },
].filter((unit) => !daysOnly || unit.key === 'days');
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  class:list={['countdown', { 'days-only': daysOnly }]}
  data-countdown={date.toISOString()}
  data-days-only={daysOnly ? 'true' : undefined}
  role="timer"
  aria-label={daysOnly ? `Le ${formatDay(date)}` : `Début : ${formatFull(date)}`}
>
  {
    units.map((unit) => (
      <span class="cd-unit">
        <strong data-unit={unit.key}>{pad(unit.value)}</strong>
        <span>{unit.label}</span>
      </span>
    ))
  }
  <p class="cd-done" hidden>C’est parti — ou c’est fini : voir la carte.</p>
</div>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = 'true';
    const target = new Date(root.dataset.countdown ?? '').getTime();
    const cells = Object.fromEntries(
      [...root.querySelectorAll<HTMLElement>('[data-unit]')].map((cell) => [cell.dataset.unit, cell]),
    );
    const daysOnly = root.dataset.daysOnly === 'true';
    const parisDay = (d: Date) =>
      new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
    const tick = () => {
      if (daysOnly) {
        // Jours de calendrier à l’heure de Paris ; « c’est parti » seulement une fois le jour passé.
        const days = Math.round((Date.parse(parisDay(new Date(target))) - Date.parse(parisDay(new Date()))) / 86400000);
        if (days < 0) {
          root.querySelectorAll('.cd-unit').forEach((unit) => unit.setAttribute('hidden', ''));
          root.querySelector('.cd-done')?.removeAttribute('hidden');
          return false;
        }
        if (cells.days) cells.days.textContent = pad(days);
        return true;
      }
      const left = target - Date.now();
      if (left <= 0) {
        root.querySelectorAll('.cd-unit').forEach((unit) => unit.setAttribute('hidden', ''));
        root.querySelector('.cd-done')?.removeAttribute('hidden');
        return false;
      }
      if (cells.days) cells.days.textContent = pad(Math.floor(left / 86400000));
      if (cells.hours) cells.hours.textContent = pad(Math.floor(left / 3600000) % 24);
      if (cells.minutes) cells.minutes.textContent = pad(Math.floor(left / 60000) % 60);
      if (cells.seconds) cells.seconds.textContent = pad(Math.floor(left / 1000) % 60);
      return true;
    };
    if (tick()) {
      const timer = setInterval(() => {
        if (!tick()) clearInterval(timer);
      }, 1000);
    }
  });
</script>
