---
import { excerpt } from '../lib/text';
import type { FeedItem } from '../lib/types';
import Avatar from './Avatar.astro';
import RelativeTime from './RelativeTime.astro';
import Visual from './Visual.astro';

/**
 * Trois variantes, une seule structure :
 * - `default` : visuel 16:9 au-dessus, texte dessous (grilles).
 * - `lead`    : grand bloc d’ouverture de « À la une », texte posé sur le visuel.
 * - `compact` : vignette à gauche, texte à droite (colonne latérale de l’une).
 */
interface Props {
  item: FeedItem;
  variant?: 'default' | 'lead' | 'compact';
  deferred?: boolean;
}

const { item, variant = 'default', deferred = false } = Astro.props;
const compact = variant === 'compact';
const summary = excerpt(item.category, item.description);
const initials =
  item.athletes[0]?.name
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0] ?? '')
    .join('')
    .toUpperCase() || item.org.initials;
---

<article
  class:list={['card', `card-${variant}`]}
  data-card
  data-category={item.category}
  data-org={item.org.id}
  data-format={item.format}
  data-video={item.hasVideo ? 'true' : 'false'}
  data-section={item.section}
  data-deferred={deferred ? 'true' : undefined}
>
  <a class="thumb" href={item.href} tabindex="-1" aria-hidden="true">
    <Visual seed={item.id} uid={`${item.id}-${variant}`} initials={initials} label="" hideInitials={variant === 'lead'} />
    {!compact && <span class="badge cat">{item.category}</span>}
    {item.example && !compact && <span class="badge ex">Contenu d’exemple</span>}
    {
      item.duration && (
        <span class="duration">
          <span class="play" aria-hidden="true" />
          {item.duration}
        </span>
      )
    }
  </a>
  <div class="body">
    <p class="channel-line">
      <a class="name" href={item.org.href}>
        {!compact && <Avatar seed={item.org.id} initials={item.org.initials} />}
        {item.org.name}
      </a>
      <span aria-hidden="true">·</span>
      <RelativeTime date={item.pubDate} />
    </p>
    <h3>
      <a href={item.href}>
        {item.example && <span class="sr-only">Contenu d’exemple. </span>}
        {item.hasVideo && <span class="sr-only">Vidéo, {item.duration}. </span>}
        {item.title}
      </a>
    </h3>
    {!compact && <p class="excerpt">{summary}</p>}
    {
      !compact && item.athletes.length > 0 && (
        <ul class="who">
          {item.athletes.map((athlete) => (
            <li>
              <a href={athlete.href}>
                {athlete.name} ({athlete.record})
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
